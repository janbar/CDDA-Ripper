QDialog{
  background-color:palette(window);
}

QPushButton{
  padding:6px 6px;
  background-color:rgba(200,200,200,10%);
  border:1px solid rgba(127,127,127,75%);
  border-radius:4px
}
QPushButton:disabled{
  padding:6px 6px;
  background-color:palette(button);
  border:1px solid rgba(127,127,127,25%);
  border-radius:4px
}
QPushButton:hover:!pressed{
  background-color:rgba(200,200,200,50%);
}
QPushButton:pressed{
  background-color:palette(dark);
  color:palette(base);
}

QToolTip{
  color:palette(text);
  background-color:palette(base);
  border:1px solid palette(highlight);
  border-radius:0px;
}

QStatusBar{
  background-color:palette(window);
  border:1px solid rgba(200,200,200,75%);
  color:palette(mid);
}

QMenuBar{
  background-color:transparent;
  spacing:0px;
  margin-left: 2px;
}
QMenuBar::item{
  spacing:2px;
  padding:4px 6px;
  background:transparent;
}
QMenuBar::item:selected{
  background-color:rgba(200,200,200,50%);
}
QMenuBar::item:pressed{
  background-color:palette(highlight);
  color:palette(base);
}
QMenu{
  background-color:palette(base);
  border:1px solid rgb(157,157,157);
}
QMenu::icon{
  padding-left:5px;
}
QMenu::item{
  padding:5px 5px;
  border-style:none;
}
QMenu::item:disabled{
  color:palette(disabled);
}
QMenu::item:selected{
  background:palette(highlight);
  color:palette(base);
}
QMenu::icon:checked{
  background-color:rgba(200,200,200,25%);
  border:1px solid palette(highlight);
  border-radius:2px;
}
QMenu::separator{
  height:1px;
  background:palette(alternate-base);
  margin-left:5px;
  margin-right:5px;
}
QMenu::indicator{
  width:15px;
  height:15px;
}
QMenu::indicator:non-exclusive:checked{
  image:url(:/goodstyle/icon_checkbox_checked.png);
  padding-left:2px;
}
QMenu::indicator:non-exclusive:unchecked{
  image:url(:/goodstyle/icon_checkbox_unchecked.png);
  padding-left:2px;
}
QMenu::indicator:exclusive:checked{
  image:url(:/goodstyle/icon_radiobutton_checked.png);
  padding-left:2px;
}
QMenu::indicator:exclusive:unchecked{
  image:url(:/goodstyle/icon_radiobutton_unchecked.png);
  padding-left:2px;
}

QToolBar::top{
  background-color:palette(window);
  border-top:1px solid rgba(200,200,200,50%);
  border-bottom:1px solid rgba(200,200,200,50%);
}
QToolBar::bottom{
  border-top:1px solid rgba(200,200,200,50%);
  border-bottom:1px solid rgba(200,200,200,50%);
}
QToolBar::left{
  border-top:1px solid rgba(200,200,200,50%);
  border-bottom:1px solid rgba(200,200,200,50%);
}
QToolBar::right{
  border-top:1px solid rgba(200,200,200,50%);
  border-bottom:1px solid rgba(200,200,200,50%);
}

QMainWindow::separator{
  width:0px;
  height:0px;
  padding:4px;
}

QComboBox{
  padding:4px 4px;
}
QComboBox QAbstractItemView {
  background-color:transparent;
}
QComboBox:item:selected {
  border: none;
  background:palette(highlight);
  color:palette(base);
}
QComboBox::indicator{
  background-color:transparent;
  selection-background-color:transparent;
  color:transparent;
  selection-color:transparent;
}

QSplitter::handle:horizontal{
  width:10px;
}
QSplitter::handle:vertical{
  height:10px;
}

QMainWindow::separator:hover,QSplitter::handle:hover{
  background:palette(highlight);
}

QDockWidget::title{
  margin-top:1px;
  padding:5px;
  background-color:rgba(127,127,127,10%);
  border-style:none;
}
QDockWidget{
  titlebar-close-icon:url(:/goodstyle/icon_close.png);
  titlebar-normal-icon:url(:/goodstyle/icon_restore.png);
}
QDockWidget::close-button,QDockWidget::float-button{
  subcontrol-position:top right;
  subcontrol-origin:margin;
  position:absolute;
  top:3px;
  bottom:0px;
  width:20px;
  height:20px;
}
QDockWidget::close-button{
  right:3px;
}
QDockWidget::float-button{
  right:25px;
}

QGroupBox{
  background-color:palette(window);
  margin-top:27px;
  border:1px solid rgba(200,200,200,50%);
  border-radius:4px;
}
QGroupBox::title{
  subcontrol-origin:margin;
  subcontrol-position:left top;
  padding:6px 6px;
  margin-left:2px;
  color: palette(highlight);
  background-color:transparent;
}

QTabWidget::pane{
  background-color:palette(window);
  border-top:1px solid rgba(200,200,200,75%);
}
QTabWidget::tab-bar{
  left:6px;
  top:0px;
}
QTabBar{
  background-color:transparent;
  qproperty-drawBase:0;
}
QTabBar::tab{
  padding:6px 8px;
  border-style:none;
}
QTabBar::tab:selected,QTabBar::tab:hover{
  background-color:rgba(200,200,200,25%);
}
QTabBar::tab:selected{
  background-color:palette(highlight);
  color:palette(base);
  border-top-left-radius:4px;
  border-top-right-radius:4px;
}
QTabBar::tab::selected:disabled{
  background-color:palette(Window);
  color:palette(WindowText);
  border-top-left-radius:4px;
  border-top-right-radius:4px;
}
QTabBar::tab:!selected{
  margin-top:2px;
}
QTabBar::close-button {
  image:url(:/goodstyle/icon_close.png);
  border:1px solid transparent;
  border-radius:4px;
}
QTabBar::close-button:hover {
  background-color:rgba(200,200,200,25%);
  border:1px solid palette(base);
}
QTabBar::close-button:pressed {
  background-color:rgba(200,200,200,25%);
  border:1px solid palette(base);
}

QCheckBox::indicator{
  width:20px;
  height:20px;
}
QCheckBox::indicator:checked,QTreeView::indicator:checked,QTableView::indicator:checked,QGroupBox::indicator:checked{
  image:url(:/goodstyle/icon_checkbox_checked.png);
}
QCheckBox::indicator:checked:pressed,QTreeView::indicator:checked:pressed,QTableView::indicator:checked:pressed,QGroupBox::indicator:checked:pressed{
  image:url(:/goodstyle/icon_checkbox_checked_pressed.png);
}
QCheckBox::indicator:checked:disabled,QTreeView::indicator:checked:disabled,QTableView::indicator:checked:disabled,QGroupBox::indicator:checked:disabled{
  image:url(:/goodstyle/icon_checkbox_checked_disabled.png);
}
QCheckBox::indicator:unchecked,QTreeView::indicator:unchecked,QTableView::indicator:unchecked,QGroupBox::indicator:unchecked{
  image:url(:/goodstyle/icon_checkbox_unchecked.png);
}
QCheckBox::indicator:unchecked:pressed,QTreeView::indicator:unchecked:pressed,QTableView::indicator:unchecked:pressed,QGroupBox::indicator:unchecked:pressed{
  image:url(:/goodstyle/icon_checkbox_unchecked_pressed.png);
}
QCheckBox::indicator:unchecked:disabled,QTreeView::indicator:unchecked:disabled,QTableView::indicator:unchecked:disabled,QGroupBox::indicator:unchecked:disabled{
  image:url(:/goodstyle/icon_checkbox_unchecked_disabled.png);
}
QCheckBox::indicator:indeterminate,QTreeView::indicator:indeterminate,QTableView::indicator:indeterminate,QGroupBox::indicator:indeterminate{
  image:url(:/goodstyle/icon_checkbox_indeterminate.png);
}
QCheckBox::indicator:indeterminate:pressed,QTreeView::indicator:indeterminate:pressed,QTableView::indicator:indeterminate:pressed,QGroupBox::indicator:indeterminate:pressed{
  image:url(:/goodstyle/icon_checkbox_indeterminate_pressed.png);
}
QCheckBox::indicator:indeterminate:disabled,QTreeView::indicator:indeterminate:disabled,QTableView::indicator:indeterminate:disabled,QGroupBox::indicator:indeterminate:disabled{
  image:url(:/goodstyle/icon_checkbox_indeterminate_disabled.png);
}

QRadioButton::indicator{
  width:20px;
  height:20px;
}
QRadioButton::indicator:checked{
  image:url(:/goodstyle/icon_radiobutton_checked.png);
}
QRadioButton::indicator:checked:pressed{
  image:url(:/goodstyle/icon_radiobutton_checked_pressed.png);
}
QRadioButton::indicator:checked:disabled{
  image:url(:/goodstyle/icon_radiobutton_checked_disabled.png);
}
QRadioButton::indicator:unchecked{
  image:url(:/goodstyle/icon_radiobutton_unchecked.png);
}
QRadioButton::indicator:unchecked:pressed{
  image:url(:/goodstyle/icon_radiobutton_unchecked_pressed.png);
}
QRadioButton::indicator:unchecked:disabled{
  image:url(:/goodstyle/icon_radiobutton_unchecked_disabled.png);
}

QTreeView, QTableView{
  alternate-background-color:palette(window);
  background:palette(base);
}
QTreeView QHeaderView::section, QTableView QHeaderView::section{
  background-color:rgba(200,200,200,25%);
  border-style:none;
  padding:4px 4px;
}
QTreeView::item, QTableView::item{
  height:24px;
  padding:4px 4px;
}
QTreeView::item:selected:disabled, QTableView::item:selected:disabled{
  background:rgb(80,80,80);
}
QTreeView::branch{
  background-color:palette(base);
}
QTreeView::branch:has-siblings:!adjoins-item{
  border-image:url(:/goodstyle/icon_vline.png) 0;
}
QTreeView::branch:has-siblings:adjoins-item{
  border-image:url(:/goodstyle/icon_branch_more.png) 0;
}
QTreeView::branch:!has-children:!has-siblings:adjoins-item{
  border-image:url(:/goodstyle/icon_branch_end.png) 0;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings{
  border-image:none;
  image:url(:/goodstyle/icon_branch_closed.png);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings{
  border-image:none;
  image:url(:/goodstyle/icon_branch_open.png);
}

QScrollBar:vertical{
  background:palette(base);
  border-top-right-radius:2px;
  border-bottom-right-radius:2px;
  width:16px;
  margin:0px;
}
QScrollBar::handle:vertical{
  background-color:palette(alternate-base);
  border-radius:2px;
  min-height:20px;
  margin:2px 4px 2px 4px;
}
QScrollBar::handle:vertical:hover{
  background-color:palette(highlight);
}
QScrollBar::add-line:vertical{
  background:none;
  height:0px;
  subcontrol-position:right;
  subcontrol-origin:margin;
}
QScrollBar::sub-line:vertical{
  background:none;
  height:0px;
  subcontrol-position:left;
  subcontrol-origin:margin;
}
QScrollBar:horizontal{
  background:palette(base);
  height:16px;
  margin:0px;
}
QScrollBar::handle:horizontal{
  background-color:palette(alternate-base);
  border-radius:2px;
  min-width:20px;
  margin:4px 2px 4px 2px;
}
QScrollBar::handle:horizontal:hover{
  background-color:palette(highlight);
}
QScrollBar::add-line:horizontal{
  background:none;
  width:0px;
  subcontrol-position:bottom;
  subcontrol-origin:margin;
}
QScrollBar::sub-line:horizontal{
  background:none;
  width:0px;
  subcontrol-position:top;
  subcontrol-origin:margin;
}

QSlider{
  padding:4px 4px 4px 4px;
}

QSlider::handle:horizontal{
  border-radius:4px;
  border:1px solid palette(highlight);
  background-color:palette(window);
  min-height:20px;
  margin:0 -4px;
}
QSlider::handle:horizontal:hover{
  background:palette(highlight);
}
QSlider::add-page:horizontal{
  background:palette(base);
}
QSlider::sub-page:horizontal{
  background:palette(highlight);
}
QSlider::sub-page:horizontal:disabled{
  background:rgb(80,80,80);
}

QSpinBox{
  padding:2px 2px;
}

QLineEdit{
  padding:4px 4px;
  background-color:palette(base);
}
QLineEdit:disabled{
  padding:4px 4px;
  background-color:palette(window);
}
